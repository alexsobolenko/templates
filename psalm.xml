        <directory name="config"/>
        <directory name="public"/>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="var"/>
            <directory name="views"/>
        </ignoreFiles>
    </projectFiles>
</psalm>
